+
+	// Walk up from the target (included, when it is a folder) to the root and use the
+	// closest mounted storage policy.
+	for _, candidate := range file.AncestorsChain() {
+		if candidate.Type() != types.FileTypeFolder || candidate.Model.StoragePolicyFiles <= 0 {
+			continue
+		}
+
+		policy, err := f.storagePolicyClient.GetPolicyByID(ctx, candidate.Model.StoragePolicyFiles)
+		if err != nil {
+			f.l.Warning("Failed to get mounted storage policy %d for folder %q: %s", candidate.Model.StoragePolicyFiles, candidate.Model.Name, err)
+			continue
+		}
+
+		return policy, nil
+	}
+
