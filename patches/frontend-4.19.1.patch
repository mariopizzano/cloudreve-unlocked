+export function mountStoragePolicy(index: number, file: FileResponse): AppThunk<Promise<void>> {
+  return async (dispatch) => {
+    const res = await dispatch(getStoragePolicyMount({ uri: file.path }));
+    const options = [
+      {
+        name: i18next.t("application:fileManager.inheritedFromParent"),
+        description: i18next.t("application:fileManager.currentStoragePolicy", {
+          policy: res.effective?.name ?? "-",
+        }),
+        value: "",
+      },
+      ...res.policies.map((policy) => ({
+        name: `${policy.name}${policy.id === res.mounted?.id ? " ✓" : ""}`,
+        description: policy.type,
+        value: policy.id,
+      })),
+    ];
+
+    let selected: any;
+    try {
+      selected = await dispatch(selectOption(options, i18next.t("application:fileManager.mountPolicy")));
+    } catch (e) {
+      // operation canceled
+      return;
+    }
+
+    await dispatch(
+      sendMountStoragePolicy({
+        uri: file.path,
+        policy_id: selected ? selected : undefined,
+      }),
+    );
+
+    dispatch(increaseStoragePolicyGeneration());
+    enqueueSnackbar({
+      message: i18next.t("application:fileManager.saved"),
+      variant: "success",
+    });
+    await dispatch(refreshFileList(index));
+  };
+}
+
+export function relocateFiles(index: number, files: FileResponse[]): AppThunk<Promise<void>> {
+  return async (dispatch) => {
+    if (files.length === 0) {
+      return;
+    }
+
+    let mountRes;
+    try {
+      mountRes = await dispatch(
+        getStoragePolicyMount({
+          uri: new CrUri(files[0].path).parent().toString(),
+        }),
+      );
+    } catch (e) {
+      return;
+    }
+
